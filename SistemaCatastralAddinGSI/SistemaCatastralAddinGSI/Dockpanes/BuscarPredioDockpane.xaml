<UserControl x:Class="SistemaCatastralAddinGSI.Dockpanes.BuscarPredioDockpaneView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="280">
 <DockPanel Margin="12">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="Buscar predio" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
   <TextBlock Text="Código, propietario, documento, distrito, manzana o lote" TextWrapping="Wrap" Margin="0,0,0,6"/>
   <TextBox x:Name="txtConsulta" Padding="8" KeyDown="Consulta_KeyDown"/>
   <Button Content="Buscar" Margin="0,8" Padding="9" Click="Buscar_Click"/>
   <TextBlock x:Name="txtCantidad" Margin="0,3,0,6"/>
  </StackPanel>
  <ListBox x:Name="lstResultados" MouseDoubleClick="Resultado_DoubleClick"/>
 </DockPanel>
</UserControl>
